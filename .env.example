# ================================================================
# Om's Portfolio AI Assistant - Environment Configuration
# ================================================================
# NOTE: Keep this file secure and NEVER commit your real secrets.
# Rename or copy this file to .env and insert your API credentials.

# Configurable AI Provider: 'gemini' | 'groq' | 'openai'
AI_PROVIDER=gemini

# Google Gemini API Key (Recommended - Free Tier Available)
# Obtain a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model identifier (optional, default is gemini-1.5-flash)
# Options: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro
AI_MODEL=gemini-1.5-flash

# Groq API Key (Alternative high-speed provider)
# Obtain at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (Alternative provider)
# Obtain at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Standalone production server port (Default: 3000)
PORT=3000
